NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, never exposed to the browser. Used for privileged admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your production URL (used for SEO metadata, sitemap.xml, robots.txt, canonical
# tags). Set this in Vercel's project env vars to the real production domain —
# https://www.trendymall.online (the www subdomain is canonical; the apex
# trendymall.online 308-redirects to it). Falls back to
# https://www.trendymall.online in production and http://localhost:3000 in
# development if this var is ever unset (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://www.trendymall.online

# Optional — analytics. Leave unset to disable (see SETUP.md for where to get these).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional — order confirmation emails via Resend (see SETUP.md).
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com

# Optional — Card payments via PayHere (see SETUP.md). The Card option at
# checkout only appears once both PAYHERE_MERCHANT_ID and
# PAYHERE_MERCHANT_SECRET are set; COD and Bank Transfer work regardless.
# Server-only — never exposed to the browser.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# sandbox (default) or live — leave as sandbox until you're ready to accept
# real payments.
PAYHERE_MODE=sandbox

# Google Ads conversion tracking. BOTH must be set for anything to load
# or fire -- leave them empty and no gtag.js request is made at all.
# The tag also only runs on www.trendymall.online / trendymall.online,
# so previews and localhost can never reach a live Ads account.
# Paste these in Vercel -> Settings -> Environment Variables (Production).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# Optional — website support chat (see SETUP.md, "11. Website support
# chat"). The chat button only appears once at least one key is set.
# Server-only — never exposed to the browser.
# Primary: free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave empty for the default (gemini-flash-latest).
GEMINI_MODEL=
# Backup used when the primary is rate limited or down: any
# OpenAI-compatible API. Defaults to Groq (free key at
# https://console.groq.com/keys); for OpenRouter set the base URL to
# https://openrouter.ai/api/v1 and pick one of its free models.
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=
FALLBACK_AI_MODEL=
